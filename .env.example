# ---- Required ----
# Token from @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Where announcements are posted: your user id (private chat with the bot),
# a channel (@my_channel or -100xxxxxxxxxx) or a group id. The bot must be admin of the channel.
# Several recipients: separate with commas, e.g. CHAT_ID=111111111,222222222
# (each person must press Start in the bot once).
CHAT_ID=123456789

# ---- Optional ----
# Who can use /commands and receives health reports. Defaults to CHAT_ID. Commas allowed.
ADMIN_ID=
# Minutes between checks
INTERVAL_MINUTES=30
# Daily health report hour (local time). -1 to disable
REPORT_HOUR=9
TIMEZONE=Africa/Casablanca
# Parallel downloads
MAX_WORKERS=8
REQUEST_TIMEOUT=25
# If one site suddenly shows more new links than this, they are saved silently (site redesign)
MAX_NEW_PER_SITE=15
# Show link previews under announcements
LINK_PREVIEW=true
# Optional free uptime monitor (https://healthchecks.io): paste your ping URL
HEALTHCHECK_URL=
# Extra keywords, comma separated (e.g. a school name you care about)
EXTRA_KEYWORDS=
# 1 = print messages in the terminal instead of sending them (for testing)
DRY_RUN=0
