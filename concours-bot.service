# Alternative to Docker: run as a systemd service.
# sudo cp concours-bot.service /etc/systemd/system/ && sudo systemctl enable --now concours-bot
[Unit]
Description=Concours notification bot
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/concours-bot
ExecStart=/home/ubuntu/concours-bot/.venv/bin/python main.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
